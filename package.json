{
  "name": "awe-ai-workforce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev ./public",
    "deploy": "wrangler pages deploy ./public --project-name=awe-ai-workforce",
    "db:init:local": "wrangler d1 execute awe-workforce --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute awe-workforce --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "check:syntax": "node --check public/app.js && node --check public/workspace.js && node --check scheduler/worker.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
